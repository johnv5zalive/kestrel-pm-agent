{
  "name": "kestrel-pm-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "20.x", "pnpm": "9.x" },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "concurrently -k -n app,css \"tsx watch --env-file=.env src/index.ts\" \"tailwindcss -i ./styles/input.css -o ./public/styles.css --watch\"",
    "build": "tsc && tailwindcss -i ./styles/input.css -o ./public/styles.css --minify",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-sqlite3": "^11.5.0",
    "hono": "^4.6.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.6",
    "concurrently": "^9.1.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
